# Copy this file to .env and fill in ONE provider block.
# .env is listed in .gitignore, so your real key never gets committed.

# Option A (free, runs on your own computer): Ollama
# Install from https://ollama.com, then run: ollama pull llama3.2
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text

# Option B (free tier in the cloud): Groq, key from https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-key-here
# LLM_MODEL=llama-3.3-70b-versatile

# Option C: OpenRouter, key from https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-openrouter-key-here
# Browse https://openrouter.ai/models (many models have a free variant)
# LLM_MODEL=openai/gpt-oss-20b

# Option D: OpenAI, key from https://platform.openai.com/api-keys
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-openai-key-here
# Pick a current model from https://platform.openai.com/docs/models
# LLM_MODEL=your-chosen-model
# EMBED_MODEL=text-embedding-3-small

# Key that callers must send in X-API-Key to use YOUR agent API (any long random string)
SERVICE_API_KEY=change-me-to-a-long-random-string
